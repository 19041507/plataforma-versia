# URL pública do backend Django hospedado no Render.
# Exemplo: https://plataforma-versia-backend.onrender.com
NEXT_PUBLIC_API_URL=

# Schema/empresa usado pelo backend multi-tenant.
# Mantenha demo se você criou o tenant demo no backend.
NEXT_PUBLIC_TENANT_SCHEMA=demo

# Deixe true durante apresentação/testes para permitir login local quando o backend dormir.
# Em produção real, use false para depender apenas do backend.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
