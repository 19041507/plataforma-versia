# ============================================
# Plataforma Versia — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório!
# ============================================

# ---- Django ----
SECRET_KEY=TROQUE-POR-UMA-CHAVE-SEGURA-AQUI
DEBUG=False

# Domínio base da plataforma (sem protocolo)
BASE_DOMAIN=versia.com.br

# Hosts permitidos (separados por vírgula)
# Em produção, inclua o domínio principal e subdomínios
ALLOWED_HOSTS=versia.com.br,api.versia.com.br,*.versia.com.br

# ---- Banco de Dados (PostgreSQL) ----
# Opção 1: URL completa (recomendado para Vercel/Neon/Supabase/Railway)
DATABASE_URL=postgresql://usuario:senha@host:5432/versia_db?sslmode=require

# Opção 2: Variáveis individuais (para Docker local)
POSTGRES_DB=versia_db
POSTGRES_USER=versia_user
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DB_HOST=localhost
DB_PORT=5432

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://api.versia.com.br

# ---- CORS (lista separada por vírgula) ----
# Origins exatas que podem fazer requisições ao backend
CORS_ALLOWED_ORIGINS=https://versia.com.br,https://www.versia.com.br
# Subdomínios dinâmicos são suportados automaticamente via BASE_DOMAIN

# ---- CSRF ----
# Origins confiáveis para POST requests (separadas por vírgula)
CSRF_TRUSTED_ORIGINS=https://versia.com.br,https://www.versia.com.br

# ---- SSL ----
# Em Vercel, deixe False (Vercel faz SSL termination)
# Em VPS com Nginx, use True
SECURE_SSL_REDIRECT=False

# ---- Domínio (usado pelo Nginx em deploy VPS) ----
DOMAIN=versia.com.br

# ---- SSL / Certbot (apenas para deploy VPS) ----
CERTBOT_EMAIL=seu-email@exemplo.com
