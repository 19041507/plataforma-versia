# ============================================
# Plataforma Versia — Variáveis de Ambiente
# ============================================

# ---- Django (Render) ----
SECRET_KEY=TROQUE-POR-UMA-CHAVE-SEGURA-AQUI
DEBUG=False
BASE_DOMAIN=versia.com.br
ALLOWED_HOSTS=versia-api.onrender.com

# ---- Banco (Supabase) ----
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require

# ---- Frontend (Vercel) ----
NEXT_PUBLIC_API_URL=https://versia-api.onrender.com
NEXT_PUBLIC_TENANT_SCHEMA=demo

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://seu-frontend.vercel.app

# ---- SSL (Render termina HTTPS no proxy) ----
SECURE_SSL_REDIRECT=False
