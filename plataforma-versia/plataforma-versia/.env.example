# ============================================
# Plataforma Versia ??? Vari??veis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no reposit??rio!
# ============================================

# ---- Django ----
SECRET_KEY=TROQUE-POR-UMA-CHAVE-SEGURA-AQUI
DEBUG=False

# Dom??nio base da plataforma (sem protocolo)
BASE_DOMAIN=versia.com.br

# Hosts permitidos (separados por v??rgula)
# Na Vercel, inclua o hostname do projeto backend (ex.: versia-api.vercel.app)
ALLOWED_HOSTS=versia-api.vercel.app

# ---- Banco de Dados (PostgreSQL) ----
# Op????o 1: URL completa (recomendado para Vercel/Neon/Supabase/Railway)
DATABASE_URL=postgresql://usuario:senha@host:5432/versia_db?sslmode=require

# Op????o 2: Vari??veis individuais (para Docker local)
POSTGRES_DB=versia_db
POSTGRES_USER=versia_user
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DB_HOST=localhost
DB_PORT=5432

# ---- Frontend (projeto Vercel separado ??? ver frontend/.env.example) ----
NEXT_PUBLIC_API_URL=https://versia-api.vercel.app
NEXT_PUBLIC_TENANT_SCHEMA=demo

# ---- CORS (lista separada por v??rgula) ----
# URL exata do frontend na Vercel
CORS_ALLOWED_ORIGINS=https://versia-app.vercel.app
# Subdom??nios din??micos s??o suportados automaticamente via BASE_DOMAIN

# ---- CSRF ----
# Origins confi??veis para POST requests (separadas por v??rgula)
CSRF_TRUSTED_ORIGINS=https://versia-app.vercel.app

# ---- SSL ----
# Em Vercel, deixe False (Vercel faz SSL termination)
# Em VPS com Nginx, use True
SECURE_SSL_REDIRECT=False

# ---- Dom??nio (usado pelo Nginx em deploy VPS) ----
DOMAIN=versia.com.br

# ---- SSL / Certbot (apenas para deploy VPS) ----
CERTBOT_EMAIL=seu-email@exemplo.com
