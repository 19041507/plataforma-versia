{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "plataforma-versia/backend/config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "installCommand": "pip install -r plataforma-versia/backend/requirements.txt && cd plataforma-versia/backend && bash build_files.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/plataforma-versia/backend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "plataforma-versia/backend/config/wsgi.py"
    }
  ]
}
