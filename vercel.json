{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r plataforma-versia/backend/requirements.txt",
  "buildCommand": "cd plataforma-versia/backend && bash build_files.sh",
  "framework": null,
  "functions": {
    "plataforma-versia/backend/api/**/*.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/plataforma-versia/backend/staticfiles/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/plataforma-versia/backend/api/index"
    }
  ]
}
